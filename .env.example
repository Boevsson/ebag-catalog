# Copy to `.env` for local development: cp .env.example .env
# Real environment variables always override this file.

# --- Required -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# MariaDB. These are the credentials of the `db` service in docker-compose.yml.
DATABASE_URL=mysql://catalog:catalog@127.0.0.1:3307/catalog

# --- Local development --------------------------------------------------------
# These two differ from the defaults (false / empty), which are the safe ones.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional (defaults shown) ------------------------------------------------
# Serve uploaded images from Django itself. Defaults to the value of DJANGO_DEBUG.
# DJANGO_SERVE_MEDIA=true
# DJANGO_MEDIA_ROOT=./media
#
# Where uploaded product images go: "local" (the disk, default) or "gcs"
# (a Google Cloud Storage bucket). Switching needs no code change.
# MEDIA_STORAGE=local
# GCS_BUCKET_NAME=my-shop-media
# GCS_CDN_URL=https://cdn.example.com      # optional: a CDN domain in front of the bucket
# GCS_LOCATION=                            # optional: a folder inside the bucket
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json   # or the machine's service account
# DJANGO_BEHIND_TLS_PROXY=false
# DATABASE_CONN_MAX_AGE=60
# JWT_SIGNING_KEY=<defaults to DJANGO_SECRET_KEY; set a dedicated key in production>
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=1
# AUTH_THROTTLE_RATE=10/min
# NUM_PROXIES=0          # trusted reverse proxies in front; 0 = ignore X-Forwarded-For
# LOG_LEVEL=INFO
